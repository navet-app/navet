{
  "name": "navet",
  "private": true,
  "version": "0.17.1",
  "description": "A provider-neutral, local-first smart-home dashboard.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/navet-app/navet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navet-app/navet.git"
  },
  "bugs": {
    "url": "https://github.com/navet-app/navet/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "agent:components": "node scripts/agent-component-catalog.mjs",
    "registry:build": "node scripts/ui-registry.mjs build",
    "registry:serve": "node scripts/ui-registry.mjs serve",
    "build": "pnpm --filter @navet/standalone build",
    "build:ha-panel": "node scripts/build-ha-panel.mjs",
    "push:ha-panel": "zsh scripts/push-ha-panel.sh",
    "reset:ha-panel-assets": "zsh scripts/reset-ha-panel-assets.sh",
    "build:demo": "pnpm --filter @navet/demo build",
    "build:storybook": "pnpm storybook:build",
    "build:website": "pnpm website:build",
    "dev": "pnpm --filter @navet/standalone dev",
    "demo:dev": "pnpm --filter @navet/demo dev",
    "website:build": "pnpm website:build:app",
    "website:build:app": "pnpm --filter @navet/website build",
    "website:dev": "pnpm --filter @navet/website dev",
    "website:preview": "pnpm --filter @navet/website preview",
    "docs:dev": "pnpm --filter @navet/docs dev",
    "docs:build": "pnpm --filter @navet/docs build",
    "docs:preview": "pnpm --filter @navet/docs preview",
    "docs:capture": "node scripts/capture-docs-media.mjs",
    "marketing:capture": "node scripts/capture-marketing-media.mjs",
    "marketing:capture:screenshots": "node scripts/capture-marketing-media.mjs --mode=screenshots",
    "marketing:capture:videos": "node scripts/capture-marketing-media.mjs --mode=videos",
    "marketing:content:new": "node scripts/content-cli.mjs new",
    "marketing:content:generate": "node scripts/content-cli.mjs generate",
    "marketing:content:check": "node scripts/content-cli.mjs check",
    "marketing:content:prepare": "node scripts/content-cli.mjs prepare",
    "marketing:content:attempt": "node scripts/content-cli.mjs attempt",
    "marketing:content:record": "node scripts/content-cli.mjs record",
    "marketing:wip:clean": "node scripts/marketing-wip.mjs clean",
    "brand:generate": "node scripts/generate-brand-reference-visuals.mjs && node scripts/brand-assets.mjs generate && node apps/website/scripts/generate-social-card.mjs",
    "docker:build": "docker build -t navet:local .",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "release:check": "node scripts/check-release-surfaces.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "release:status": "node scripts/release-status.mjs",
    "release:notes:generate": "node scripts/generate-release-notes.mjs",
    "release:fragments:check": "node scripts/check-release-fragments.mjs",
    "release:version-sync": "node scripts/sync-release-versions.mjs",
    "release:dev-version": "node scripts/set-dev-addon-version.mjs",
    "release:dev-publish": "node scripts/create-dev-release.mjs",
    "export:hacs": "node scripts/export-hacs-integration.mjs",
    "sync:hacs": "node scripts/sync-hacs-repo.mjs",
    "release:export-hacs": "node scripts/export-hacs-integration.mjs",
    "wallpapers:audit": "node scripts/wallpapers.mjs audit",
    "wallpapers:optimize": "node scripts/wallpapers.mjs optimize",
    "wallpapers:check": "node scripts/wallpapers.mjs check",
    "preview": "pnpm build && pnpm preview:config && pnpm --filter @navet/standalone preview",
    "preview:private": "node scripts/run-private-preview.mjs",
    "preview:config": "node scripts/write-preview-config.mjs",
    "provider-lab:install": "node scripts/install-provider-lab.mjs all",
    "provider-lab:openhab": "node scripts/install-provider-lab.mjs openhab",
    "provider-lab:homey": "node scripts/install-provider-lab.mjs homey",
    "clean:root": "node scripts/clean-root-artifacts.mjs",
    "clean:all": "node scripts/clean-root-artifacts.mjs --all",
    "storybook": "pnpm registry:build && pnpm storybook:only",
    "storybook:build": "STORYBOOK=1 STORYBOOK_BASE_PATH=/ HOME=$PWD/.cache/storybook/home XDG_CONFIG_HOME=$PWD/.cache/storybook STORYBOOK_DISABLE_TELEMETRY=1 pnpm --filter @navet/storybook run build",
    "build-storybook": "pnpm storybook:build",
    "lint": "biome lint ./packages",
    "format": "biome format --write ./packages",
    "check": "biome check ./packages",
    "check:stories": "node scripts/check-storybook-standards.mjs",
    "check:ui-kit": "node scripts/check-ui-kit-boundaries.mjs && node scripts/check-theme-color-safelist.mjs && node scripts/ui-registry.mjs build",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:website-audit": "node scripts/check-website-audit.mjs",
    "check:brand": "node scripts/brand-assets.mjs check",
    "check:runtime-policies": "node scripts/build-runtime-policies.mjs --check",
    "check:rss-transport": "docker build --target rss-transport-build -t navet:rss-transport-check .",
    "check:provider-boundaries": "node scripts/check-provider-boundaries.mjs",
    "check:docker": "node scripts/check-docker-runtime.mjs",
    "check:lockfile": "node scripts/check-pnpm-lock-sync.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:commitmsg": "node scripts/check-commit-message.mjs",
    "validate": "node scripts/validate-scope.mjs",
    "check:fix": "biome check --apply ./packages",
    "report:bundle": "node scripts/inspect-bundle.mjs",
    "report:ui-kit": "node scripts/check-ui-kit-usage.mjs",
    "agent:tasks": "node scripts/agent-task.mjs",
    "agent:usage": "node scripts/agent-codex-usage-cli.mjs",
    "agent:validation": "node scripts/agent-validation-receipt-cli.mjs",
    "test": "vitest --config vitest.unit.config.ts --project \"unit*\"",
    "test:tier1": "node scripts/run-test-tier.mjs tier1",
    "test:blocking": "node scripts/run-test-tier.mjs blocking",
    "test:tier2": "node scripts/run-test-tier.mjs tier2",
    "test:tier3": "node scripts/run-test-tier.mjs tier3",
    "test:ha-integration": "python3 -m unittest discover -s platform/home-assistant/tests -p 'test_*.py'",
    "test:coverage": "vitest --config vitest.unit.config.ts --project \"unit*\" --coverage",
    "test:storybook": "vitest --project \"storybook:$PWD/apps/storybook/.storybook\"",
    "test:visual-review": "pnpm build:demo && node scripts/run-pr-visual-review.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "storybook:only": "STORYBOOK=1 HOME=$PWD/.cache/storybook/home XDG_CONFIG_HOME=$PWD/.cache/storybook STORYBOOK_DISABLE_TELEMETRY=1 pnpm --filter @navet/storybook run storybook",
    "registry:dev": "node scripts/registry-dev.mjs",
    "registry:publish": "node scripts/ui-registry.mjs publish",
    "test:registry": "vitest --config vitest.unit.config.ts --project \"unit*\" --run scripts/ui-registry.test.mjs scripts/ui-shell-recipes.test.mjs scripts/registry-preview.test.mjs scripts/registry-catalog.test.mjs scripts/agent-component-catalog.test.mjs",
    "registry:preview": "node scripts/registry-preview.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-slider": "1.4.7",
    "clsx": "2.1.1",
    "hls.js": "^1.7.3",
    "home-assistant-js-websocket": "^9.7.0",
    "lucide-react": "1.49.0",
    "maplibre-gl": "^6.11.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "8.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "parse5": "8.0.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
